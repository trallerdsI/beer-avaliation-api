# ======================================================================
# BEER REVIEW API - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ======================================================================
# Instruções: Copie este ficheiro, nomeie a cópia como ".env" e ajuste os valores.
# IMPORTANTE: Nunca envie o ficheiro ".env" real para o GitHub.

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DO SERVIDOR
# ------------------------------------------------------------------------------
SERVER_PORT=8082
# Nota: A Vercel atribui os portos dinamicamente em produção, mas mantenha esta
# variável para que o Viper não falhe nas validações locais.

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES PARA AMBIENTE LOCAL (DOCKER / DEVELOPMENT)
# ------------------------------------------------------------------------------
# Estas três variáveis são consumidas pelo seu 'docker-compose.yaml' para provisionar o banco:
DB_USER=postgres
DB_PASSWORD=beer_secure_password123
DB_NAME=beer_review_db

# Esta é a string de ligação que a API em Go usará para se ligar ao Docker local:
DBConnString=postgres://postgres:beer_secure_password123@localhost:5432/beer_review_db?sslmode=disable

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES PARA PRODUÇÃO (VERCEL + NEON)
# ------------------------------------------------------------------------------
# ADVERTÊNCIA: Não coloque a string de produção neste ficheiro local!
# Adicione a chave abaixo diretamente no painel da Vercel (Settings > Environment Variables).
#
# Regra de Ouro do Neon: Use SEMPRE o link que contém "-pooler" e o parâmetro sslmode=require
# Exemplo do formato esperado na Vercel:
# DBConnString=postgres://seu_usuario:sua_senha@ep-cool-pooler-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# SEGURANÇA (JWT)
# ------------------------------------------------------------------------------
# Chave secreta para assinar e validar os tokens de login dos utilizadores.
# OBRIGATÓRIO: sem esta variável o serviço recusa gerar/validar tokens.
JWT_SECRET=substitua_isto_por_um_hash_aleatorio_e_seguro_em_producao

# ------------------------------------------------------------------------------
# POOL DE CONEXÕES (opcional, defaults: 10 open / 5 idle)
# ------------------------------------------------------------------------------
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
