# ======================================================================
# BEER REVIEW API - CONFIGURAÇÃO STAGING (.env.staging.example)
# ======================================================================
# Este ficheiro define as variáveis específicas do ambiente de Staging.
# Copie para .env.staging e ajuste os valores para o seu ambiente.
# NUNCA comite o .env.staging real com credenciais.

# ------------------------------------------------------------------------------
# IDENTIFICAÇÃO DO AMBIENTE
# ------------------------------------------------------------------------------
ENVIRONMENT=staging

# ------------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL isolado para Staging)
# ------------------------------------------------------------------------------
# Porta diferente para evitar conflito com dev local (5432) e produção
STAGING_DB_PORT=5433
STAGING_DB_USER=postgres
STAGING_DB_PASSWORD=<SECRET_0e5c4267>word
STAGING_DB_NAME=beer_review_staging

# Pool de conexões (Staging pode ter carga menor que produção)
STAGING_DB_MAX_OPEN_CONNS=5
STAGING_DB_MAX_IDLE_CONNS=2

# ------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------
STAGING_API_PORT=8082

# ------------------------------------------------------------------------------
# SEGURANÇA
# ------------------------------------------------------------------------------
# IMPORTANTE: Use uma chave DIFERENTE da produção!
# Esta chave é usada para assinar JWTs no ambiente de staging.
STAGING_JWT_SECRET=substitua_por_chave_staging_diferente_da_producao

# ------------------------------------------------------------------------------
# CORS (origens do ambiente de staging)
# ------------------------------------------------------------------------------
STAGING_CORS_ORIGINS=https://staging-app.example.com,https://staging-admin.example.com

# ------------------------------------------------------------------------------
# LOGS E OBSERVABILIDADE
# ------------------------------------------------------------------------------
# Nível de log: debug, info, warn, error
STAGING_LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# MÍDIA (Storage)
# ------------------------------------------------------------------------------
# Em staging, use um bucket separado ou o mesmo com dados de teste
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SECRET_5cbafa8d>
SUPABASE_STORAGE_BUCKET=beer-media-staging

# ------------------------------------------------------------------------------
# OAUTH / OIDC
# ------------------------------------------------------------------------------
# Use credenciais de teste/sandbox, NUNCA credenciais de produção
OAUTH_GOOGLE_AUDIENCE=seu-client-id-staging.googleusercontent.com
OAUTH_GOOGLE_JWKS_URL=
OAUTH_APPLE_AUDIENCE=
OAUTH_APPLE_JWKS_URL=

# ------------------------------------------------------------------------------
# WEB PUSH
# ------------------------------------------------------------------------------
# Chaves VAPID de staging (diferentes da produção)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:staging-admin@example.com

# ------------------------------------------------------------------------------
# RESET DE SCHEMA
# ------------------------------------------------------------------------------
# Em staging, NÃO resetar o schema automaticamente para preservar dados
# de teste entre deploys. Use apenas migrations incrementais.
DB_RESET_SCHEMA=false
