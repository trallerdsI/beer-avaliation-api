{
    "info": {
        "name": "Beer Review API",
        "description": "Collection of API endpoints for the Beer Review application",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Users",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "url": "http://localhost:8082/api/v1/users/register",
                        "header": {
                            "Content-Type": "application/json"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": {
                                "username": "testuser",
                                "email": "test@example.com",
                                "password": "password123"
                            }
                        }
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "url": "http://localhost:8082/api/v1/users/login",
                        "header": {
                            "Content-Type": "application/json"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": {
                                "email": "test@example.com",
                                "password": "password123"
                            }
                        }
                    }
                },
                {
                    "name": "Get Profile",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/api/v1/users/{id}",
                        "header": {
                            "Authorization": "Bearer {token}"
                        }
                    }
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "PUT",
                        "url": "http://localhost:8082/api/v1/users/{id}",
                        "header": {
                            "Authorization": "Bearer {token}",
                            "Content-Type": "application/json"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": {
                                "username": "updateduser",
                                "email": "updated@example.com"
                            }
                        }
                    }
                },
                {
                    "name": "Delete Account",
                    "request": {
                        "method": "DELETE",
                        "url": "http://localhost:8082/api/v1/users/{id}",
                        "header": {
                            "Authorization": "Bearer {token}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Beers",
            "item": [
                {
                    "name": "Get All Beers",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/api/v1/beers",
                        "query": [
                            {
                                "key": "page",
                                "value": "1"
                            },
                            {
                                "key": "pageSize",
                                "value": "10"
                            }
                        ]
                    }
                },
                {
                    "name": "Create Beer",
                    "request": {
                        "method": "POST",
                        "url": "http://localhost:8082/api/v1/beers",
                        "header": {
                            "Content-Type": "application/json",
                            "Authorization": "Bearer {token}"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": {
                                "name": "Test Beer",
                                "style": "IPA",
                                "description": "A test beer",
                                "alcohol": 5.5,
                                "taste": "Amargo",
                                "aroma": "Frutado",
                                "color": "Clara",
                                "body": "Médio",
                                "carbonation": "Média",
                                "finish": "Seco"
                            }
                        }
                    }
                },
                {
                    "name": "Get Beer by ID",
                    "request": {
                        "method": "GET",
                        "url": "http://localhost:8082/api/v1/beers/{id}"
                    }
                },
                {
                    "name": "Update Beer",
                    "request": {
                        "method": "PUT",
                        "url": "http://localhost:8082/api/v1/beers/{id}",
                        "header": {
                            "Content-Type": "application/json",
                            "Authorization": "Bearer {token}"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": {
                                "name": "Updated Beer",
                                "description": "An updated description"
                            }
                        }
                    }
                },
                {
                    "name": "Delete Beer",
                    "request": {
                        "method": "DELETE",
                        "url": "http://localhost:8082/api/v1/beers/{id}",
                        "header": {
                            "Authorization": "Bearer {token}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Comments",
            "item": [
                {
                    "name": "Add Comment",
                    "request": {
                        "method": "POST",
                        "url": "http://localhost:8082/api/v1/beers/{id}/comments",
                        "header": {
                            "Content-Type": "application/json",
                            "Authorization": "Bearer {token}"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": {
                                "text": "Great beer!",
                                "positive": true
                            }
                        }
                    }
                },
                {
                    "name": "Delete Comment",
                    "request": {
                        "method": "DELETE",
                        "url": "http://localhost:8082/api/v1/beers/{id}/comments/{commentId}",
                        "header": {
                            "Authorization": "Bearer {token}"
                        }
                    }
                },
                {
                    "name": "Like Comment",
                    "request": {
                        "method": "POST",
                        "url": "http://localhost:8082/api/v1/beers/{id}/comments/{commentId}/like",
                        "header": {
                            "Authorization": "Bearer {token}",
                            "X-Device-ID": "unique-device-id"
                        }
                    }
                }
            ]
        }
    ]
}