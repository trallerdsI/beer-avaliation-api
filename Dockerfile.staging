# Build stage - Same as production for paridade
FROM golang:1.26.5-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o main cmd/server/main.go

FROM gcr.io/distroless/static-debian12

WORKDIR /

COPY --from=builder /app/main /main

RUN chmod +x /main

EXPOSE 8082

USER 65532:65532

LABEL org.opencontainers.image.title="beer-avaliation-api" \
      org.opencontainers.image.description="Beer catalog API with moderation (staging)" \
      org.opencontainers.image.vendor="Beer Review" \
      org.opencontainers.image.licenses="MIT"

CMD ["/main"]
